:[225,46],"flags":{"collapsed":false},"order":10,"mode":0,"inputs":[{"label":"pixels","localized_name":"像素","name":"pixels","type":"IMAGE","link":108},{"label":"vae","localized_name":"vae","name":"vae","type":"VAE","link":110}],"outputs":[{"label":"LATENT","localized_name":"Latent","name":"LATENT","type":"LATENT","links":[112]}],"properties":{"Node name for S&R":"VAEEncode","cnr_id":"comfy-core","ver":"0.26.0","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.1"},"widget_ue_connectable":{}}},{"id":93,"type":"VAEEncode","pos":[646.9114727272729,631.0119000000007],"size":[346,53.700000000000045],"flags":{"collapsed":false},"order":11,"mode":0,"inputs":[{"label":"pixels","localized_name":"像素","name":"pixels","type":"IMAGE","link":109},{"label":"vae","localized_name":"vae","name":"vae","type":"VAE","link":111}],"outputs":[{"label":"LATENT","localized_name":"Latent","name":"LATENT","type":"LATENT","links":[113]}],"properties":{"Node name for S&R":"VAEEncode","cnr_id":"comfy-core","ver":"0.26.0","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.5.1"},"widget_ue_connectable":{}}},{"id":94,"type":"MarkdownNote","pos":[-474.1480841472577,405.2592036063111],"size":[420,220],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"说明","properties":{"Node name for S&R":"MarkdownNote"},"widgets_values":["# Krea2 换装（Identity Edit v1.2）—— 目前脸部最稳的一条\n\n`Krea 2 Identity Edit v1.2` 官方支持 **try-on / 换头 / 换衣**，靠 `ref_boost` 控制\n“像不像”。本 demo 用两张参考图：\n\n- `人像图片` → image 1 / source_image（决定长相、发型、身材）\n- `服装图片` → image 2 / source_image_b（决定穿什么）\n\n模型链：`krea2_turbo_fp8_scaled` → `krea2_identity_edit_v1_2` → `Krea2EditModelPatch`\n→ KSampler（8 步、cfg 1、euler/simple）。\n\n调参：\n- **ref_boost（默认 4）**：2~6 之间试。越高越像参考图，太高会僵、会直接“贴图”。\n- 服装不听话：在正向指令里把衣服细节写具体（颜色 / 材质 / 版型 / 长度）。\n- 脸不像：换更清晰的正脸人像；或把 `服装图片` 从 source_image_b 挪走，只留一张参考。\n- 想要指定姿势：Krea2 这一版不吃第三张参考图，姿势来自 source_image（人像图）本身；\n  要按姿势图摆动作，用 demo 03 / 04 的 MOSS 深度控制，或先用姿势图生成再换脸。\n\n正向指令故意写成英文：Krea2 的 edit 分支训练语料以英文指令为主，中文能跑但稳定性差一些。\n把节点里这段文案换成中文也能用，改完直接跑就行。"],"widgets_values_named":{"text":"# Krea2 换装（Identity Edit v1.2）—— 目前脸部最稳的一条\n\n`Krea 2 Identity Edit v1.2` 官方支持 **try-on / 换头 / 换衣**，靠 `ref_boost` 控制\n“像不像”。本 demo 用两张参考图：\n\n- `人像图片` → image 1 / source_image（决定长相、发型、身材）\n- `服装图片` → image 2 / source_image_b（决定穿什么）\n\n模型链：`krea2_turbo_fp8_scaled` → `krea2_identity_edit_v1_2` → `Krea2EditModelPatch`\n→ KSampler（8 步、cfg 1、euler/simple）。\n\n调参：\n- **ref_boost（默认 4）**：2~6 之间试。越高越像参考图，太高会僵、会直接“贴图”。\n- 服装不听话：在正向指令里把衣服细节写具体（颜色 / 材质 / 版型 / 长度）。\n- 脸不像：换更清晰的正脸人像；或把 `服装图片` 从 source_image_b 挪走，只留一张参考。\n- 想要指定姿势：Krea2 这一版不吃第三张参考图，姿势来自 source_image（人像图）本身；\n  要按姿势图摆动作，用 demo 03 / 04 的 MOSS 深度控制，或先用姿势图生成再换脸。\n\n正向指令故意写成英文：Krea2 的 edit 分支训练语料以英文指令为主，中文能跑但稳定性差一些。\n把节点里这段文案换成中文也能用，改完直接跑就行。"},"color":"#432","bgcolor":"#653"},{"id":95,"type":"ResolutionSelector","pos":[1138.489033023439,781.8924051099274],"size":[259.0717847141591,150],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"宽高比","name":"aspect_ratio","type":"COMBO","widget":{"name":"aspect_ratio"},"link":null},{"localized_name":"百万像素","name":"megapixels","type":"FLOAT","widget":{"name":"megapixels"},"link":null},{"localized_name":"倍数","name":"multiple","type":"INT","widget":{"name":"multiple"},"link":null},{"localized_name":"预览","name":"preview","shape":7,"type":"RESOLUTION_PREVIEW","widget":{"name":"preview"},"link":null}],"outputs":[{"localized_name":"宽度","name":"width","type":"INT","links":[126]},{"localized_name":"高度","name":"height","type":"INT","links":[127]}],"properties":{"Node name for S&R":"ResolutionSelector"},"widgets_values":["3:4 (Portrait Standard)",1.5,16],"widgets_values_named":{"aspect_ratio":"3:4 (Portrait Standard)","megapixels":1.5,"multiple":16}},{"id":96,"type":"LoraLoaderModelOnly","pos":[638.7134878309721,934.4231951182062],"size":[362,86],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"模型","name":"model","type":"MODEL","link":null},{"local